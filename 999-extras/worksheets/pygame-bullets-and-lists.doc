<p class="ruled">&nbsp;</p><p class="ruled">&nbsp;</p><p class="ruled">&nbsp;</p>

<pre><code class="language-python">bullets = []
bullets.append([197, 300])
bullets.append([197, 300])
bullets.append([197, 300])

print(len(bullets))
</code></pre>
