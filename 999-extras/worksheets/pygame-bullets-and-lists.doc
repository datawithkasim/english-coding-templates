<p class="ruled">&nbsp;</p><p class="ruled">&nbsp;</p><p class="ruled">&nbsp;</p>

<pre><code class="language-python">bullets = [[0, 10], [0, 20], [0, 30], [0, 40]]

for bullet in bullets:
    bullets.remove(bullet)

print(bullets)
</code></pre>
